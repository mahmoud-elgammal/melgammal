---
import "../../styles/global.scss";
import bricolageWoff2 from "@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2";
import jakartaWoff2 from "@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2";
import jbMonoWoff2 from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2";

import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/plus-jakarta-sans";
import "@fontsource-variable/jetbrains-mono";
// Loaded for the Expertise canvas's kinetic skill-tag rendering, which
// intentionally uses a different, denser display face than page headings.
import "@fontsource/anton";

import "katex/dist/katex.min.css";

import { ClientRouter } from "astro:transitions";
import { SITE } from "@consts";

interface Props {
  title: string;
  description: string;
  image?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = "/nano.png" } = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link
  rel="icon"
  type="image/svg+xml"
  href="/favicon-dark.svg"
  media="(prefers-color-scheme: dark)"
/>
<link
  rel="icon"
  type="image/svg+xml"
  href="/favicon-light.svg"
  media="(prefers-color-scheme: light)"
/>
<link rel="icon" type="image/x-icon" href="/favicon-light.svg" />
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<link
  rel="preload"
  href={bricolageWoff2}
  as="font"
  type="font/woff2"
  crossorigin
/>
<link rel="preload" href={jakartaWoff2} as="font" type="font/woff2" crossorigin />
<link
  rel="preload"
  href={jbMonoWoff2}
  as="font"
  type="font/woff2"
  crossorigin
/>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />

<ClientRouter />

<!-- RSS Link -->
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE.NAME}
  href={new URL("rss.xml", Astro.site)}
/>

<script>
  import type { TransitionBeforeSwapEvent } from "astro:transitions/client";
  document.addEventListener("astro:before-swap", (e) =>
    [
      ...(e as TransitionBeforeSwapEvent).newDocument.head.querySelectorAll(
        'link[as="font"]',
      ),
    ].forEach((link) => link.remove()),
  );

  // Custom GSAP curtain transition for entering/leaving /desktop (the
  // fake-OS canvas app) — the native view-transition crossfade is
  // suppressed for this route pair (see global.scss) so this is the only
  // animation running.
  //
  // Rather than guess at CSS animation-delay values to line up with the
  // actual page swap, astro:before-preparation lets the swap itself be
  // *awaited*: wrapping event.loader means Astro won't fetch/swap the new
  // page until our cover animation has actually finished, so the curtain
  // is always fully opaque before anything changes underneath it — no
  // race, no guessed timing.
  document.addEventListener("astro:before-preparation", (event) => {
    // @ts-ignore - to/from/loader aren't part of TransitionBeforeSwapEvent's
    // type, but astro:before-preparation's event does carry them.
    const toPath = event.to?.pathname as string | undefined;
    // @ts-ignore
    const fromPath = event.from?.pathname as string | undefined;

    const enteringDesktop = toPath === "/desktop" && fromPath !== "/desktop";
    const leavingDesktop = fromPath === "/desktop" && toPath !== "/desktop";
    if (!enteringDesktop && !leavingDesktop) return;

    // Suppresses the default ::view-transition-old/new(root) fade for
    // this route pair (see global.scss) so it doesn't run underneath —
    // and, since GSAP can't target native view-transition pseudo-elements
    // directly, this class is also how that CSS rule knows to back off.
    document.documentElement.classList.add(
      enteringDesktop ? "transition-to-desktop" : "transition-from-desktop",
    );

    // @ts-ignore
    const originalLoader = event.loader;
    // @ts-ignore
    event.loader = async () => {
      const { coverScreen } = await import("@lib/desktopTransition");
      await coverScreen(
        enteringDesktop ? "Booting desktop.wasm…" : "Returning to site…",
      );
      // The incoming document needs to start already covered — Astro's
      // swap is a DOM replacement, not a cross-fade, so without this
      // there'd be one frame of the new page showing before our reveal
      // animation (bound on the new document) gets a chance to run.
      sessionStorage.setItem("transition-precovered", "1");
      await originalLoader();
    };
  });

  document.addEventListener("astro:after-swap", async () => {
    document.documentElement.classList.remove(
      "transition-to-desktop",
      "transition-from-desktop",
    );
    const { revealScreen } = await import("@lib/desktopTransition");
    revealScreen();
  });
</script>

<script is:inline>
  // ── Lifecycle-safe init: each call disposes the previous run's listeners ──
  // Astro view transitions fire `astro:after-swap` on every navigation, so we
  // were stacking duplicate scroll/click/media-query listeners on each swap.
  // We now track an AbortController per init and abort it before re-binding.
  let pageController = null;
  let themeMqlBound = false;

  function init() {
    // Tear down listeners from the previous page (if any)
    if (pageController) pageController.abort();
    pageController = new AbortController();
    const { signal } = pageController;

    onScroll();
    animate();

    const backToTop = document.getElementById("back-to-top");
    backToTop?.addEventListener("click", (event) => scrollToTop(event), {
      signal,
    });

    const backToPrev = document.getElementById("back-to-prev");
    backToPrev?.addEventListener("click", () => window.history.back(), {
      signal,
    });

    document.addEventListener("scroll", onScroll, { signal, passive: true });

    // The OS theme listener should bind exactly once for the whole session
    if (!themeMqlBound) {
      themeMqlBound = true;
      window
        .matchMedia("(prefers-color-scheme: dark)")
        .addEventListener("change", (event) => {
          // A manual choice from the header toggle should stick even if
          // the OS preference changes underneath it.
          if (!localStorage.getItem("theme-override")) {
            toggleTheme(event.matches);
          }
        });
    }
  }

  function animate() {
    // Honor prefers-reduced-motion: reveal everything instantly
    const reduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    const animateElements = document.querySelectorAll(".animate");

    if (reduced) {
      animateElements.forEach((el) => el.classList.add("show"));
      return;
    }

    animateElements.forEach((element, index) => {
      setTimeout(() => {
        element.classList.add("show");
      }, index * 150);
    });
  }

  function onScroll() {
    if (window.scrollY > 0) {
      document.documentElement.classList.add("scrolled");
    } else {
      document.documentElement.classList.remove("scrolled");
    }
  }

  function scrollToTop(event) {
    event.preventDefault();
    window.scrollTo({
      top: 0,
      behavior: "smooth",
    });
  }

  function toggleTheme(dark) {
    const css = document.createElement("style");

    css.appendChild(
      document.createTextNode(
        `* {
             -webkit-transition: none !important;
             -moz-transition: none !important;
             -o-transition: none !important;
             -ms-transition: none !important;
             transition: none !important;
          }
        `,
      ),
    );

    document.head.appendChild(css);

    if (dark) {
      document.documentElement.classList.add("dark");
    } else {
      document.documentElement.classList.remove("dark");
    }

    // window.getComputedStyle(css).opacity; - REMOVED: This causes a forced reflow.
    document.head.removeChild(css);
  }

  function preloadTheme() {
    const override = localStorage.getItem("theme-override");
    const dark =
      override === "dark" ||
      (override !== "light" &&
        window.matchMedia("(prefers-color-scheme: dark)").matches);
    toggleTheme(dark);
  }

  // Exposed for the header's theme toggle switch — sets an explicit
  // preference that persists across visits and overrides the OS setting.
  window.__setThemeOverride = function (dark) {
    localStorage.setItem("theme-override", dark ? "dark" : "light");
    toggleTheme(dark);
  };

  document.addEventListener("DOMContentLoaded", () => init());
  document.addEventListener("astro:after-swap", () => init());
  preloadTheme();
</script>
