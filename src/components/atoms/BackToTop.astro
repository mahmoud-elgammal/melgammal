<button id="back-to-top" aria-label="Back to top">
  <span class="icon-wrap">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="icon">
      <line x1="12" y1="19" x2="12" y2="5" class="line"></line>
      <polyline points="5 12 12 5 19 12" class="polyline"></polyline>
    </svg>
  </span>
  <span class="text">Back to top</span>
</button>

<style lang="scss">
  @use "../../styles/variables" as *;
  @use "../../styles/mixins" as *;

  // Solid pill, matching the site's established black/white button
  // language (e.g. the About section's "View Resume" button) rather than
  // the previous transparent/bordered minimal style.
  #back-to-top {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    width: fit-content;
    padding: 0.55rem 1.1rem 0.55rem 0.6rem;
    border-radius: 999px;
    border: none;
    background: $color-black;
    color: $color-white;
    cursor: pointer;
    font-family: $font-mono;
    text-decoration: none;
    transition:
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1);

    @include dark {
      background: $color-white;
      color: $color-black;
    }

    @include hover {
      transform: translateY(-3px) scale(1.03);
      box-shadow: 0 12px 24px rgba(0, 0, 0, 0.18);

      .icon-wrap {
        transform: translateY(-1px);
      }

      @include dark {
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.4);
      }
    }
  }

  .icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: rgba($color-white, 0.15);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);

    @include dark {
      background: rgba($color-black, 0.1);
    }
  }

  .icon {
    width: 0.9rem;
    height: 0.9rem;
    stroke-width: 2.25;
    fill: none;
    stroke: currentColor;
  }

  .text {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
</style>
