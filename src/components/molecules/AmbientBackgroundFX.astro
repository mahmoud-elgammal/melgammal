---
// Fixed, full-viewport GLSL flow-noise background sitting behind every
// section of the homepage (not just the hero). z-index: -1 keeps it behind
// all normal in-flow content without requiring any other component to
// declare its own stacking order.
---

<canvas id="ambient-bg-canvas" class="ambient-bg-canvas" aria-hidden="true"
></canvas>

<style>
    .ambient-bg-canvas {
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        width: 100vw;
        height: 100vh;
    }
</style>

<script>
    import { registerAnimation, prefersReducedMotion } from "@lib/animation";

    const vertexShader = /* glsl */ `
        void main() {
            gl_Position = vec4(position, 1.0);
        }
    `;

    const fragmentShader = /* glsl */ `
        precision highp float;

        uniform float uTime;
        uniform vec2 uResolution;
        uniform vec2 uMouse;
        uniform vec3 uColor;

        vec2 hash(vec2 p) {
            p = vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)));
            return -1.0 + 2.0 * fract(sin(p) * 43758.5453123);
        }

        float noise(vec2 p) {
            const float K1 = 0.366025404;
            const float K2 = 0.211324865;
            vec2 i = floor(p + (p.x + p.y) * K1);
            vec2 a = p - i + (i.x + i.y) * K2;
            vec2 o = (a.x > a.y) ? vec2(1.0, 0.0) : vec2(0.0, 1.0);
            vec2 b = a - o + K2;
            vec2 c = a - 1.0 + 2.0 * K2;
            vec3 h = max(0.5 - vec3(dot(a, a), dot(b, b), dot(c, c)), 0.0);
            vec3 n = h * h * h * h * vec3(
                dot(a, hash(i + 0.0)),
                dot(b, hash(i + o)),
                dot(c, hash(i + 1.0))
            );
            return dot(n, vec3(70.0));
        }

        void main() {
            vec2 uv = gl_FragCoord.xy / uResolution.xy;
            vec2 st = uv * 2.0 - 1.0;
            st.x *= uResolution.x / uResolution.y;

            vec2 mouseInfluence = (uMouse - 0.5) * 0.25;
            float t = uTime * 0.035;
            vec2 p = st * 1.2 + mouseInfluence;

            float n = 0.0;
            n += noise(p + t) * 0.5;
            n += noise(p * 2.0 - t * 1.3) * 0.25;
            n += noise(p * 4.0 + t * 0.7) * 0.125;

            // Kept deliberately faint — this is background atmosphere for
            // the whole page, not a focal point like the hero title effect.
            float alpha = smoothstep(0.0, 0.7, n) * 0.05;
            gl_FragColor = vec4(uColor, alpha);
        }
    `;

    class AmbientBackgroundScene {
        private canvas: HTMLCanvasElement;
        private renderer: any;
        private scene: any;
        private camera: any;
        private material: any;
        private clock: any;
        private rafId: number | null = null;
        private mouse = { x: 0.5, y: 0.5 };
        private targetMouse = { x: 0.5, y: 0.5 };
        private reduced: boolean;
        private themeObserver: MutationObserver | null = null;

        constructor(canvas: HTMLCanvasElement, THREE: any, signal: AbortSignal) {
            this.canvas = canvas;
            this.reduced = prefersReducedMotion();
            this.clock = new THREE.Clock();

            this.renderer = new THREE.WebGLRenderer({
                canvas,
                alpha: true,
                antialias: false,
                powerPreference: "low-power",
            });
            this.renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));

            this.scene = new THREE.Scene();
            this.camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);

            this.material = new THREE.ShaderMaterial({
                vertexShader,
                fragmentShader,
                transparent: true,
                uniforms: {
                    uTime: { value: 0 },
                    uResolution: { value: new THREE.Vector2(1, 1) },
                    uMouse: { value: new THREE.Vector2(0.5, 0.5) },
                    uColor: { value: this.getThemeColor(THREE) },
                },
            });

            const geometry = new THREE.PlaneGeometry(2, 2);
            this.scene.add(new THREE.Mesh(geometry, this.material));

            this.resize();
            window.addEventListener("resize", () => this.resize(), {
                signal,
                passive: true,
            });

            if (!this.reduced) {
                window.addEventListener(
                    "mousemove",
                    (e) => {
                        this.targetMouse.x = e.clientX / window.innerWidth;
                        this.targetMouse.y =
                            1 - e.clientY / window.innerHeight;
                    },
                    { signal, passive: true },
                );
            }

            this.themeObserver = new MutationObserver(() => {
                this.material.uniforms.uColor.value = this.getThemeColor(
                    THREE,
                );
            });
            this.themeObserver.observe(document.documentElement, {
                attributes: true,
                attributeFilter: ["class"],
            });

            signal.addEventListener("abort", () => this.stop());

            this.renderer.render(this.scene, this.camera);
            if (!this.reduced) this.animate();
        }

        private getThemeColor(THREE: any) {
            const isDark =
                document.documentElement.classList.contains("dark");
            return new THREE.Color(isDark ? 0xf8f8f6 : 0x0a0a0a);
        }

        private resize() {
            const width = window.innerWidth;
            const height = window.innerHeight;
            this.renderer.setSize(width, height, false);
            this.material.uniforms.uResolution.value.set(width, height);
        }

        private animate = () => {
            this.rafId = requestAnimationFrame(this.animate);

            this.mouse.x += (this.targetMouse.x - this.mouse.x) * 0.04;
            this.mouse.y += (this.targetMouse.y - this.mouse.y) * 0.04;
            this.material.uniforms.uMouse.value.set(
                this.mouse.x,
                this.mouse.y,
            );
            this.material.uniforms.uTime.value = this.clock.getElapsedTime();

            this.renderer.render(this.scene, this.camera);
        };

        public stop() {
            if (this.rafId) cancelAnimationFrame(this.rafId);
            this.rafId = null;
            this.themeObserver?.disconnect();
            this.themeObserver = null;
            this.material.dispose();
            this.renderer.dispose();
        }
    }

    document.addEventListener("astro:page-load", () => {
        registerAnimation("ambient-bg", async (_gsap, signal) => {
            const canvas = document.getElementById(
                "ambient-bg-canvas",
            ) as HTMLCanvasElement | null;
            if (!canvas) return;

            try {
                const THREE = await import("three");
                // eslint-disable-next-line no-new -- disposal wired via AbortSignal
                new AmbientBackgroundScene(canvas, THREE, signal);
            } catch {
                // Three.js/WebGL unavailable — page just has no ambient FX.
            }
        });
    });
</script>
