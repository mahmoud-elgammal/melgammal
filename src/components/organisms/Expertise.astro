---
import { Icon } from "astro-icon/components";

const SKILLS = [
    { name: "Node.js", slug: "nodejs", icon: "logos:nodejs-icon", size: "lg" },
    {
        name: "TypeScript",
        slug: "typescript",
        icon: "logos:typescript-icon",
        size: "md",
    },
    { name: "React", slug: "react", icon: "logos:react", size: "sm" },
    {
        name: "Prometheus",
        slug: "prometheus",
        icon: "logos:prometheus",
        size: "lg",
    },
    { name: "Grafana", slug: "grafana", icon: "logos:grafana", size: "md" },
    { name: "Docker", slug: "docker", icon: "logos:docker-icon", size: "sm" },
    { name: "K8s", slug: "k8s", icon: "logos:kubernetes", size: "md" },
    {
        name: "k6",
        slug: "k6",
        icon: "simple-icons:k6",
        color: "#7D64FF",
        size: "sm",
    },
    { name: "Three.js", slug: "threejs", icon: "logos:threejs", size: "lg" },
    {
        name: "React Native",
        slug: "react-native",
        icon: "logos:react",
        size: "sm",
    },
    { name: "Rust", slug: "rust", icon: "logos:rust", size: "md" },
    { name: "AWS", slug: "aws", icon: "logos:aws", size: "md" },
    { name: "Astro.js", slug: "astro", icon: "logos:astro-icon", size: "lg" },
];
---

<section
    class="expertise-section animate"
    id="expertise-container"
    data-scroll-personality="technical"
>
    <div class="architectural-void" id="prism-board">
        <!-- Blueprint Grid System -->
        <div class="technical-grid"></div>

        <!-- Canvas Rendering Layer -->
        <canvas id="expertise-canvas" class="expertise-canvas"></canvas>

        <!-- WebGL glow/chromatic-aberration pass, sampling the 2D canvas
             above and distorting it around the cursor -->
        <canvas
            id="expertise-glow-canvas"
            class="expertise-glow-canvas"
        ></canvas>

        <!-- Interactive Technical HUD -->
        <div class="discovery-lens" id="discovery-lens">
            <div class="lens-labels">
                <span class="label-coord" id="lens-x">X: 000</span>
                <span class="label-coord" id="lens-y">Y: 000</span>
                <span class="label-status">SYSTEM: OPTIC_ACTIVE</span>
            </div>
            <div class="lens-crosshair"></div>
        </div>
    </div>

    <!-- Server-rendered icon source: the canvas script reads these SVGs
         to rasterize them onto <canvas>, since Astro's Icon component
         only runs at build/server time. -->
    <div class="icon-sprite-source" aria-hidden="true">
        {
            SKILLS.map((skill) => (
                <Icon
                    name={skill.icon}
                    id={`skill-icon-${skill.slug}`}
                    style={skill.color ? `color:${skill.color}` : undefined}
                />
            ))
        }
    </div>
</section>

<div class="expertise-mobile-fallback">
    <div class="section-header">
        <h5 class="section-title">Core Competencies</h5>
    </div>
    <ul class="mobile-skills-list">
        <!-- Render from server to eliminate all JS dependency on mobile -->
        {
            SKILLS.map((skill) => (
                <li class={`skill-pill size-${skill.size}`}>
                    <Icon
                        name={skill.icon}
                        title={skill.name}
                        style={
                            skill.color ? `color:${skill.color}` : undefined
                        }
                    />
                </li>
            ))
        }
    </ul>
</div>

<script>
    import Matter from "matter-js";
    import { gsap } from "gsap";
    import {
        registerAnimation,
        prefersReducedMotion,
    } from "@lib/animation";

    const {
        Engine,
        Events,
        Runner,
        Bodies,
        Composite,
        Body: MatterBody,
    } = Matter;

    const SKILLS = [
        { name: "Node.js", slug: "nodejs", depth: 1.25, size: "lg" },
        { name: "TypeScript", slug: "typescript", depth: 1, size: "md" },
        { name: "React", slug: "react", depth: 0.75, size: "sm" },
        { name: "Prometheus", slug: "prometheus", depth: 1.25, size: "lg" },
        { name: "Grafana", slug: "grafana", depth: 1, size: "md" },
        { name: "Docker", slug: "docker", depth: 0.75, size: "sm" },
        { name: "K8s", slug: "k8s", depth: 1.25, size: "md" },
        { name: "k6", slug: "k6", depth: 1, size: "sm" },
        { name: "Three.js", slug: "threejs", depth: 0.75, size: "lg" },
        {
            name: "React Native",
            slug: "react-native",
            depth: 1.25,
            size: "sm",
        },
        { name: "Rust", slug: "rust", depth: 1, size: "md" },
        { name: "AWS", slug: "aws", depth: 0.75, size: "md" },
        { name: "Astro.js", slug: "astro", depth: 1.25, size: "lg" },
    ];

    class ExpertiseCanvas {
        private board: HTMLElement;
        private boardRect!: DOMRect;
        private canvas: HTMLCanvasElement;
        private ctx: CanvasRenderingContext2D;
        private engine: any;
        private runner: any;
        private bodies: any[] = [];
        private dpr: number = 1;
        private mouse = { x: 0, y: 0, active: false };
        private theme: "light" | "dark" = "light";
        private observer: MutationObserver | null = null;
        private intersectionObserver: IntersectionObserver | null = null;
        private rafId: number | null = null;
        private isMobile: boolean = false;
        private signal: AbortSignal;
        private icons: Map<string, HTMLImageElement> = new Map();

        constructor(signal: AbortSignal) {
            this.signal = signal;
            this.board = document.getElementById("prism-board")!;
            this.canvas = document.getElementById(
                "expertise-canvas",
            ) as HTMLCanvasElement;
            this.ctx = this.canvas.getContext("2d")!;
            this.theme = document.documentElement.classList.contains("dark")
                ? "dark"
                : "light";

            this.observer = new MutationObserver(() => {
                this.theme = document.documentElement.classList.contains(
                    "dark",
                )
                    ? "dark"
                    : "light";
            });
            this.observer.observe(document.documentElement, {
                attributes: true,
                attributeFilter: ["class"],
            });

            // PERFORMANCE: Defer init until the section is in view
            this.intersectionObserver = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) {
                            this.init();
                            this.intersectionObserver?.disconnect();
                            this.intersectionObserver = null;
                        }
                    });
                },
                { rootMargin: "200px" },
            );

            this.intersectionObserver.observe(this.board);

            // Auto-dispose when the registered animation is reverted
            this.signal.addEventListener("abort", () => this.stop());
        }

        private init() {
            this.resize();
            window.addEventListener("resize", () => this.resize(), {
                signal: this.signal,
                passive: true,
            });

            // CPU SAVER: Bypass all heavy Physics simulation if mobile viewport
            if (this.isMobile) return;

            this.loadIcons();

            // Physics Setup
            this.engine = Engine.create();
            this.engine.gravity.y = 0;

            const width = this.canvas.width / this.dpr;
            const height = this.canvas.height / this.dpr;

            // Create Physics Bodies
            this.bodies = SKILLS.map((skill) => {
                const iconSize = this.getIconSize(skill.size);
                const padding = iconSize * 0.9;
                const rectW = iconSize + padding;
                const rectH = iconSize + padding;

                const x = (Math.random() * 0.6 + 0.2) * width;
                const y = (Math.random() * 0.6 + 0.2) * height;

                const body = Bodies.rectangle(x, y, rectW, rectH, {
                    chamfer: { radius: 10 },
                    restitution: 0.8,
                    frictionAir: 0.04 / skill.depth,
                    label: "skill-tag",
                });

                return {
                    body,
                    skill,
                    width: rectW,
                    height: rectH,
                    iconSize,
                    revealOpacity: 0,
                };
            });

            // Boundaries
            const wallOptions = { isStatic: true, restitution: 1 };
            Composite.add(this.engine.world, [
                ...this.bodies.map((b) => b.body),
                Bodies.rectangle(
                    width / 2,
                    height + 100,
                    width,
                    200,
                    wallOptions,
                ),
                Bodies.rectangle(width / 2, -100, width, 200, wallOptions),
                Bodies.rectangle(-100, height / 2, 200, height, wallOptions),
                Bodies.rectangle(
                    width + 100,
                    height / 2,
                    200,
                    height,
                    wallOptions,
                ),
            ]);

            // Reveal Animation
            this.bodies.forEach((b, i) => {
                gsap.to(b, {
                    revealOpacity: 1,
                    duration: 1.5,
                    delay: i * 0.05,
                    ease: "power4.out",
                });
            });

            this.setupInteraction();

            this.runner = Runner.create();
            Runner.run(this.runner, this.engine);

            Events.on(this.engine, "afterUpdate", () => this.draw());
        }

        private getIconSize(size: string) {
            if (size === "lg") return this.isMobile ? 40 : 56;
            if (size === "md") return this.isMobile ? 32 : 44;
            return this.isMobile ? 24 : 34;
        }

        // Rasterizes each server-rendered icon (see .icon-sprite-source)
        // into an Image the canvas can drawImage() every frame. astro-icon
        // renders each icon as a <symbol>+<use> pair rather than a flat,
        // self-contained <svg>, so a standalone document has to be
        // reassembled from the <symbol>'s viewBox/markup before it's valid
        // as a data: URI image source.
        private loadIcons() {
            SKILLS.forEach((skill) => {
                const source = document.getElementById(
                    `skill-icon-${skill.slug}`,
                );
                const symbol = source?.querySelector("symbol");
                if (!symbol) return;

                const viewBox = symbol.getAttribute("viewBox") || "0 0 24 24";
                const style = source!.getAttribute("style") || "";
                const markup = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="${viewBox}" style="${style}">${symbol.innerHTML}</svg>`;

                const img = new Image();
                img.src = `data:image/svg+xml;charset=utf-8,${encodeURIComponent(markup)}`;
                this.icons.set(skill.slug, img);
            });
        }

        private resize() {
            this.isMobile = window.innerWidth < 768;
            this.dpr = window.devicePixelRatio || 1;
            this.boardRect = this.board.getBoundingClientRect();
            const rect = this.boardRect;
            this.canvas.width = rect.width * this.dpr;
            this.canvas.height = rect.height * this.dpr;
            this.canvas.style.width = `${rect.width}px`;
            this.canvas.style.height = `${rect.height}px`;
            this.ctx.scale(this.dpr, this.dpr);
        }

        private setupInteraction() {
            const lens = document.getElementById("discovery-lens");
            const coordX = document.getElementById("lens-x");
            const coordY = document.getElementById("lens-y");

            this.board.addEventListener(
                "mousemove",
                (e) => {
                    const target = e.target as HTMLElement;
                    if (target === this.canvas) {
                        this.mouse.x = e.offsetX;
                        this.mouse.y = e.offsetY;
                    } else {
                        const rect = this.boardRect;
                        this.mouse.x = e.clientX - rect.left;
                        this.mouse.y = e.clientY - rect.top;
                    }
                    this.mouse.active = true;

                    if (lens && !this.rafId) {
                        this.rafId = requestAnimationFrame(() => {
                            lens.style.transform = `translate3d(${this.mouse.x - 125}px, ${this.mouse.y - 125}px, 0)`;
                            lens.style.opacity = "1";
                            if (coordX)
                                coordX.innerText = `X: ${Math.round(this.mouse.x).toString().padStart(3, "0")}`;
                            if (coordY)
                                coordY.innerText = `Y: ${Math.round(this.mouse.y).toString().padStart(3, "0")}`;
                            this.rafId = null;
                        });
                    }
                },
                { signal: this.signal },
            );

            this.board.addEventListener(
                "mouseleave",
                () => {
                    this.mouse.active = false;
                    if (lens) lens.style.opacity = "0";
                },
                { signal: this.signal },
            );
        }

        private draw() {
            this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);

            // Sort by depth for correct layering (back to front)
            const sortedBodies = [...this.bodies].sort(
                (a, b) => a.skill.depth - b.skill.depth,
            );

            sortedBodies.forEach(
                ({ body, skill, width, height, iconSize, revealOpacity }) => {
                    const { depth } = skill;

                    // Attraction Physics
                    if (this.mouse.active) {
                        const dx = this.mouse.x - body.position.x;
                        const dy = this.mouse.y - body.position.y;
                        const dist = Math.sqrt(dx * dx + dy * dy);
                        const range = 400 * depth;

                        if (dist < range) {
                            const pull = 0.001 * depth * (1 - dist / range);
                            MatterBody.applyForce(body, body.position, {
                                x: dx * pull,
                                y: dy * pull,
                            });
                        }
                    }

                    // Spacing
                    this.bodies.forEach((other) => {
                        if (other.body === body) return;
                        const dx = other.body.position.x - body.position.x;
                        const dy = other.body.position.y - body.position.y;
                        const distSq = dx * dx + dy * dy;
                        if (distSq < 12000) {
                            const push = 0.0003 / (distSq + 1);
                            MatterBody.applyForce(body, body.position, {
                                x: -dx * push,
                                y: -dy * push,
                            });
                        }
                    });

                    // Rendering Calculations
                    const focusDist = this.mouse.active
                        ? Math.sqrt(
                              Math.pow(this.mouse.x - body.position.x, 2) +
                                  Math.pow(this.mouse.y - body.position.y, 2),
                          )
                        : 500;
                    const blur = Math.max(
                        0,
                        focusDist / 150 - 1 + (1 - depth) * 2,
                    );
                    const opacity = (0.2 + depth * 0.8) * revealOpacity;
                    const scale = depth * (1 + body.speed * 0.015);
                    const skewX = body.velocity.x * 0.6;

                    this.ctx.save();
                    this.ctx.translate(body.position.x, body.position.y);
                    this.ctx.rotate(body.angle);
                    this.ctx.scale(scale, scale);
                    this.ctx.transform(
                        1,
                        0,
                        Math.tan((skewX * Math.PI) / 180),
                        1,
                        0,
                        0,
                    );

                    this.ctx.globalAlpha = opacity;

                    // Chip background
                    this.ctx.fillStyle =
                        this.theme === "dark" ? "#1c1c1a" : "#ffffff";
                    this.ctx.beginPath();
                    this.ctx.roundRect(
                        -width / 2,
                        -height / 2,
                        width,
                        height,
                        10,
                    );
                    this.ctx.fill();
                    this.ctx.strokeStyle =
                        this.theme === "dark"
                            ? "rgba(255,255,255,0.08)"
                            : "rgba(0,0,0,0.06)";
                    this.ctx.lineWidth = 1;
                    this.ctx.stroke();

                    // Colored logo, aspect-ratio preserved within the chip
                    const img = this.icons.get(skill.slug);
                    if (img && img.complete && img.naturalWidth > 0) {
                        const aspect = img.naturalWidth / img.naturalHeight;
                        let drawW = iconSize;
                        let drawH = iconSize;
                        if (aspect > 1) drawH = iconSize / aspect;
                        else drawW = iconSize * aspect;
                        this.ctx.drawImage(
                            img,
                            -drawW / 2,
                            -drawH / 2,
                            drawW,
                            drawH,
                        );
                    }

                    this.ctx.restore();
                },
            );
        }

        public stop() {
            if (this.runner) {
                Runner.stop(this.runner);
                this.runner = null;
            }
            if (this.engine) {
                Engine.clear(this.engine);
                this.engine = null;
            }
            if (this.observer) {
                this.observer.disconnect();
                this.observer = null;
            }
            if (this.intersectionObserver) {
                this.intersectionObserver.disconnect();
                this.intersectionObserver = null;
            }
            if (this.rafId) {
                cancelAnimationFrame(this.rafId);
                this.rafId = null;
            }
            this.icons.clear();
            // Resize listener is auto-removed via the AbortSignal
        }
    }

    const GLOW_VERTEX_SRC = `
        attribute vec2 aPosition;
        void main() {
            gl_Position = vec4(aPosition, 0.0, 1.0);
        }
    `;

    // Renders nothing outside a soft circular radius around the cursor —
    // this is a "lens" pass, not a full-canvas effect, so the plain 2D
    // physics canvas underneath shows through normally everywhere else.
    const GLOW_FRAGMENT_SRC = `
        precision highp float;
        uniform sampler2D uTexture;
        uniform vec2 uResolution;
        uniform vec2 uMouse;
        uniform float uRadius;

        void main() {
            if (uMouse.x < 0.0) discard;

            float dist = distance(gl_FragCoord.xy, uMouse);
            if (dist > uRadius) discard;

            vec2 uv = gl_FragCoord.xy / uResolution.xy;
            vec2 mouseUv = uMouse / uResolution;
            vec2 dir = normalize(uv - mouseUv + 0.0001);

            float edgeFade = smoothstep(uRadius, uRadius * 0.55, dist);
            float aberration = 0.01 * (dist / uRadius);

            float r = texture2D(uTexture, uv + dir * aberration).r;
            float g = texture2D(uTexture, uv).g;
            float b = texture2D(uTexture, uv - dir * aberration).b;
            vec3 color = vec3(r, g, b) * 1.2;

            gl_FragColor = vec4(color, edgeFade * 0.85);
        }
    `;

    function compileGlowShader(
        gl: WebGLRenderingContext,
        type: number,
        source: string,
    ): WebGLShader | null {
        const shader = gl.createShader(type);
        if (!shader) return null;
        gl.shaderSource(shader, source);
        gl.compileShader(shader);
        if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
            gl.deleteShader(shader);
            return null;
        }
        return shader;
    }

    // A chromatic-aberration "lens" that follows the cursor over the skill
    // canvas, sampling the live 2D physics render as its texture each
    // frame. Purely additive on top of ExpertiseCanvas — never replaces it.
    class ExpertiseGlowFX {
        private sourceCanvas: HTMLCanvasElement;
        private canvas: HTMLCanvasElement;
        private gl: WebGLRenderingContext;
        private program: WebGLProgram;
        private texture: WebGLTexture;
        private uniforms: Record<string, WebGLUniformLocation | null> = {};
        private dpr = Math.min(window.devicePixelRatio || 1, 2);
        private mouse = { x: -1, y: -1 };
        private rafId: number | null = null;
        private board: HTMLElement;
        private boardRect!: DOMRect;

        constructor(
            board: HTMLElement,
            sourceCanvas: HTMLCanvasElement,
            canvas: HTMLCanvasElement,
            signal: AbortSignal,
        ) {
            this.board = board;
            this.sourceCanvas = sourceCanvas;
            this.canvas = canvas;

            const gl = (canvas.getContext("webgl") ||
                canvas.getContext(
                    "experimental-webgl",
                )) as WebGLRenderingContext | null;
            if (!gl) throw new Error("WebGL unavailable");
            this.gl = gl;

            const program = this.createProgram();
            if (!program) throw new Error("shader program failed");
            this.program = program;

            const texture = gl.createTexture();
            if (!texture) throw new Error("texture creation failed");
            this.texture = texture;

            this.setupGeometry();
            this.resize();

            window.addEventListener("resize", () => this.resize(), {
                signal,
                passive: true,
            });

            board.addEventListener(
                "mousemove",
                (e) => {
                    this.mouse.x =
                        (e.clientX - this.boardRect.left) * this.dpr;
                    this.mouse.y =
                        (this.boardRect.height -
                            (e.clientY - this.boardRect.top)) *
                        this.dpr;
                },
                { signal, passive: true },
            );
            board.addEventListener(
                "mouseleave",
                () => {
                    this.mouse.x = -1;
                    this.mouse.y = -1;
                },
                { signal, passive: true },
            );

            signal.addEventListener("abort", () => this.stop());
            this.loop();
        }

        private createProgram(): WebGLProgram | null {
            const { gl } = this;
            const vertexShader = compileGlowShader(
                gl,
                gl.VERTEX_SHADER,
                GLOW_VERTEX_SRC,
            );
            const fragmentShader = compileGlowShader(
                gl,
                gl.FRAGMENT_SHADER,
                GLOW_FRAGMENT_SRC,
            );
            if (!vertexShader || !fragmentShader) return null;

            const program = gl.createProgram();
            if (!program) return null;
            gl.attachShader(program, vertexShader);
            gl.attachShader(program, fragmentShader);
            gl.linkProgram(program);
            if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
                return null;
            }

            gl.useProgram(program);
            ["uTexture", "uResolution", "uMouse", "uRadius"].forEach(
                (name) => {
                    this.uniforms[name] = gl.getUniformLocation(
                        program,
                        name,
                    );
                },
            );
            return program;
        }

        private setupGeometry() {
            const { gl, program } = this;
            const positions = new Float32Array([-1, -1, 3, -1, -1, 3]);
            const buffer = gl.createBuffer();
            gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
            gl.bufferData(gl.ARRAY_BUFFER, positions, gl.STATIC_DRAW);

            const aPosition = gl.getAttribLocation(program, "aPosition");
            gl.enableVertexAttribArray(aPosition);
            gl.vertexAttribPointer(aPosition, 2, gl.FLOAT, false, 0, 0);
        }

        private resize() {
            this.boardRect = this.board.getBoundingClientRect();
            const width = Math.max(1, this.boardRect.width);
            const height = Math.max(1, this.boardRect.height);
            this.canvas.width = Math.round(width * this.dpr);
            this.canvas.height = Math.round(height * this.dpr);
            this.gl.viewport(0, 0, this.canvas.width, this.canvas.height);
        }

        private loop = () => {
            this.rafId = requestAnimationFrame(this.loop);
            if (this.mouse.x < 0) return;

            const { gl } = this;
            gl.useProgram(this.program);
            gl.clearColor(0, 0, 0, 0);
            gl.clear(gl.COLOR_BUFFER_BIT);
            gl.enable(gl.BLEND);
            gl.blendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA);

            gl.bindTexture(gl.TEXTURE_2D, this.texture);
            gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, true);
            try {
                gl.texImage2D(
                    gl.TEXTURE_2D,
                    0,
                    gl.RGBA,
                    gl.RGBA,
                    gl.UNSIGNED_BYTE,
                    this.sourceCanvas,
                );
            } catch {
                return;
            }
            gl.texParameteri(
                gl.TEXTURE_2D,
                gl.TEXTURE_MIN_FILTER,
                gl.LINEAR,
            );
            gl.texParameteri(
                gl.TEXTURE_2D,
                gl.TEXTURE_MAG_FILTER,
                gl.LINEAR,
            );
            gl.texParameteri(
                gl.TEXTURE_2D,
                gl.TEXTURE_WRAP_S,
                gl.CLAMP_TO_EDGE,
            );
            gl.texParameteri(
                gl.TEXTURE_2D,
                gl.TEXTURE_WRAP_T,
                gl.CLAMP_TO_EDGE,
            );

            gl.uniform2f(
                this.uniforms.uResolution,
                this.canvas.width,
                this.canvas.height,
            );
            gl.uniform2f(this.uniforms.uMouse, this.mouse.x, this.mouse.y);
            gl.uniform1f(this.uniforms.uRadius, 140 * this.dpr);

            gl.drawArrays(gl.TRIANGLES, 0, 3);
        };

        public stop() {
            if (this.rafId) cancelAnimationFrame(this.rafId);
            this.rafId = null;
            this.gl.deleteTexture(this.texture);
            this.gl.deleteProgram(this.program);
        }
    }

    document.addEventListener("astro:page-load", () => {
        registerAnimation("expertise-canvas", (_gsap, signal) => {
            // Reduced motion: skip the entire physics simulation; the static
            // mobile fallback CSS rule already shows a clean skill list on
            // small viewports, but on desktop with reduced-motion we just
            // hide the architectural void to avoid any kinetic motion.
            if (prefersReducedMotion()) {
                const board = document.getElementById("prism-board");
                if (board) board.style.display = "none";
                return;
            }

            const board = document.getElementById("prism-board");
            const canvas = document.getElementById("expertise-canvas");
            if (!board || !canvas) return;

            // eslint-disable-next-line no-new -- intentional fire-and-forget;
            // disposal is wired through the AbortSignal in the constructor.
            new ExpertiseCanvas(signal);

            const isMobile = window.innerWidth < 768;
            const glowCanvas = document.getElementById(
                "expertise-glow-canvas",
            ) as HTMLCanvasElement | null;
            if (!isMobile && glowCanvas) {
                try {
                    // eslint-disable-next-line no-new -- disposal wired via AbortSignal
                    new ExpertiseGlowFX(
                        board as HTMLElement,
                        canvas as HTMLCanvasElement,
                        glowCanvas,
                        signal,
                    );
                } catch {
                    // WebGL unavailable — the plain 2D canvas is unaffected.
                }
            }
        });
    });
</script>

