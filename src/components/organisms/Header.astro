---
import Container from "@components/atoms/Container.astro";
import Link from "@components/atoms/Link.astro";
import Button from "@components/atoms/Button.astro";
import LanguageSwitch from "@components/atoms/LanguageSwitch.astro";
import { NAV_SHORTCUTS } from "@lib/shortcuts";
---

<!-- Shortcut toast notification -->
<div id="shortcut-toast" class="shortcut-toast" aria-live="polite"></div>

<!-- Shortcut help panel (toggled with ?) -->
<!-- NOTE: Must stay before <header> for CSS sibling selector (~) to work -->
<div id="shortcut-panel" class="shortcut-panel" aria-hidden="true">
    <div class="shortcut-panel-inner">
        <div class="shortcut-panel-header">
            <h3>Keyboard Shortcuts</h3>
            <kbd>?</kbd> to close
        </div>
        <ul class="shortcut-list" id="shortcut-list"></ul>
    </div>
</div>

<script is:inline>
    // FOUC Fix: Immediately reveal header if already animated in this session
    // This runs before the rest of the page renders to prevent flicker
    (function () {
        if (sessionStorage.getItem("header-animated") === "true") {
            document.documentElement.classList.add("header-skip-anim");
        }
    })();
</script>

<header id="site-header" class="header-anim">
    <Container>
        <div class="header-content">
            <!-- <div class="nav-group">
                <Link href="/" underline={false}>
                    <div class="brand" id="header-brand">M. El-Gammal</div>
                </Link>
            </div> -->

            <div class="pellmell-wrapper" id="pellmell-nav">
                <a href="/" class="pellmell-logo" aria-label="Go to homepage">
                    <span class="logo-mark">M</span>
                    <span class="logo-dot" aria-hidden="true"></span>
                </a>

                <nav
                    class="pellmell-bar"
                    id="pellmell-bar"
                    data-state="collapsed"
                    aria-label="Primary"
                >
                    <span
                        class="pellmell-nav-bg"
                        id="pellmell-nav-bg"
                        aria-hidden="true"></span>

                    {
                        NAV_SHORTCUTS.map((shortcut) => (
                            <Link
                                href={shortcut.href}
                                class="pellmell-nav-item"
                                underline={false}
                                aria-keyshortcuts={shortcut.keys}
                                tabindex="-1"
                            >
                                <span>{shortcut.label}</span>
                            </Link>
                        ))
                    }

                    <button
                        type="button"
                        id="pellmell-trigger"
                        class="pellmell-menu-label"
                        aria-expanded="false"
                        aria-label="Toggle menu"
                    >
                        <span>M</span><span>e</span><span>n</span><span>u</span>
                    </button>
                </nav>

                <a
                    href="/desktop"
                    id="pellmell-desktop-toggle"
                    class="pellmell-desktop-toggle"
                    aria-label="Switch to desktop mode"
                    aria-pressed="false"
                >
                    <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="desktop-toggle-icon"
                    >
                        <rect x="2" y="3" width="20" height="14" rx="2"></rect>
                        <line x1="8" y1="21" x2="16" y2="21"></line>
                        <line x1="12" y1="17" x2="12" y2="21"></line>
                    </svg>
                </a>
            </div>

            <!-- <div class="actions-group">
                <div id="header-lang">
                    <LanguageSwitch />
                </div>
                <div id="header-cta" class="desktop-cta">
                    <Button
                        href="https://cal.com/mahmoud-elgammal/intro"
                        variant="outline"
                        target="_blank"
                        rel="noopener noreferrer">Book Intro</Button
                    >
                </div>
                <button
                    id="mobile-menu-toggle"
                    class="mobile-menu-toggle"
                    aria-label="Toggle Menu"
                >
                    <span class="line line-1"></span>
                    <span class="line line-2"></span>
                </button>
            </div> -->
        </div>
    </Container>

    <!-- Mobile Menu Overlay -->
    <div id="mobile-menu-overlay" class="mobile-menu-overlay">
        <div class="overlay-content">
            <nav class="mobile-nav">
                {
                    NAV_SHORTCUTS.map((shortcut) => (
                        <Link href={shortcut.href} class="mobile-nav-link">
                            <span class="link-label">{shortcut.label}</span>
                            <span class="link-hint">{shortcut.hint}</span>
                        </Link>
                    ))
                }
            </nav>
            <div class="overlay-footer">
                <Button
                    href="https://cal.com/mahmoud-elgammal/intro"
                    variant="outline"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-full">Book Intro</Button
                >
            </div>
        </div>
    </div>
</header>

<script>
    import { gsap } from "gsap";
    // @ts-ignore
    import { tinykeys } from "tinykeys";
    import { NAV_SHORTCUTS } from "@lib/shortcuts";
    import { registerAnimation, prefersReducedMotion } from "@lib/animation";

    /* ── Brand letter splitting ── */
    function splitBrandLetters(brand: HTMLElement): HTMLElement[] {
        const text = brand.textContent || "";
        brand.innerHTML = "";
        const letters: HTMLElement[] = [];

        text.split("").forEach((char) => {
            const span = document.createElement("span");
            span.classList.add("brand-letter");
            span.textContent = char === " " ? "\u00A0" : char;
            span.style.opacity = "0";
            span.style.display = "inline-block";
            brand.appendChild(span);
            letters.push(span);
        });

        return letters;
    }

    /* ── Header entrance animation ── */
    async function animateHeader() {
        const hasAnimated = sessionStorage.getItem("header-animated");
        // @ts-ignore
        if (window._headerAnimating) return;

        const header = document.getElementById("site-header");
        const brand = document.getElementById("header-brand");
        const pellmellNav = document.getElementById("pellmell-nav");
        const cta = document.getElementById("header-cta");
        const lang = document.getElementById("header-lang");

        const markReady = () => {
            // @ts-ignore
            window.headerReady = true;
            document.dispatchEvent(new CustomEvent("header-ready"));
        };

        // 1. Skip animation if reduced motion OR already seen in this session.
        // The reveal itself must not depend on `brand` — it's commented out
        // of the markup, and gating the reveal on it left the header stuck
        // at opacity: 0 forever on a fresh session.
        if (hasAnimated || prefersReducedMotion()) {
            if (brand) {
                const letters = splitBrandLetters(brand);
                brand.style.opacity = "1";
                gsap.set(letters, { opacity: 1, y: 0 });
            }
            header!.classList.remove("header-anim");
            gsap.set([pellmellNav, cta, lang], {
                opacity: 1,
                x: 0,
                y: 0,
                scale: 1,
            });
            sessionStorage.setItem("header-animated", "true");
            markReady();
            return;
        }

        // @ts-ignore
        window._headerAnimating = true;

        // ── Short delay for Landing Page instead of sync ──
        if (window.location.pathname === "/") {
            await new Promise((resolve) => setTimeout(resolve, 300));
        }

        const tl = gsap.timeline({
            onComplete: () => {
                sessionStorage.setItem("header-animated", "true");
                // @ts-ignore
                window._headerAnimating = false;
                markReady();
            },
        });

        // Reveal the shell first — unconditional, regardless of whether the
        // (currently disabled) brand mark is present.
        tl.to(header, { opacity: 1, duration: 0.2 });
        header!.classList.remove("header-anim");

        // 1. Brand name — letter unfold (only when the brand mark is enabled)
        if (brand) {
            const letters = splitBrandLetters(brand);
            brand.style.opacity = "1";

            tl.fromTo(
                letters,
                { opacity: 0, y: 12 },
                {
                    opacity: 1,
                    y: 0,
                    duration: 0.5,
                    stagger: 0.03,
                    ease: "power4.out",
                    onComplete: () => {
                        // Clear transforms to remove stacking context without losing visibility
                        gsap.set(letters, {
                            clearProps: "transform,translate,rotate,scale",
                        });
                    },
                },
                "<",
            );
        }

        // 2. The pellmell nav drops in
        if (pellmellNav) {
            tl.fromTo(
                pellmellNav,
                { opacity: 0, y: -8, scale: 0.95 },
                {
                    opacity: 1,
                    y: 0,
                    scale: 1,
                    duration: 0.45,
                    ease: "power4.out",
                },
                "-=0.3",
            );
        }

        // 4. CTA button scales in
        if (cta) {
            tl.fromTo(
                cta,
                { opacity: 0, scale: 0.9 },
                { opacity: 1, scale: 1, duration: 0.4, ease: "back.out(1.7)" },
                "-=0.2",
            );
        }

        // 5. Language switch fades in
        if (lang) {
            tl.fromTo(
                lang,
                { opacity: 0, y: 8 },
                { opacity: 1, y: 0, duration: 0.4, ease: "power4.out" },
                "-=0.2",
            );
        }
    }

    /* ── Pellmell nav: "Menu" pill morphs into logo + links + theme toggle ── */
    function setupPellmellNav(signal: AbortSignal) {
        const wrapper = document.getElementById("pellmell-nav");
        const bar = document.getElementById("pellmell-bar");
        const trigger = document.getElementById("pellmell-trigger");
        const navBg = document.getElementById("pellmell-nav-bg");
        const logo = wrapper?.querySelector<HTMLElement>(".pellmell-logo");
        const desktopToggle = document.getElementById(
            "pellmell-desktop-toggle",
        );
        const items =
            document.querySelectorAll<HTMLAnchorElement>(".pellmell-nav-item");

        if (!wrapper || !bar || !trigger || !navBg) return;

        // At rest, only the "Menu" pill shows — the logo and desktop
        // toggle are tucked out of view behind it (slightly offset +
        // scaled down) and slide out into place as the bar expands, rather
        // than sitting there permanently.
        const sideOffset = 22;
        wrapper.dataset.state = "collapsed";
        if (logo) {
            gsap.set(logo, { opacity: 0, x: sideOffset, scale: 0.7 });
        }
        if (desktopToggle) {
            gsap.set(desktopToggle, {
                opacity: 0,
                x: -sideOffset,
                scale: 0.7,
            });
        }

        const reduced = prefersReducedMotion();

        // Mark whichever item matches the current page, and keep a handle
        // on it — it's where the sliding highlight rests by default.
        const currentPath = window.location.pathname.replace(/\/$/, "") || "/";
        let activeItem: HTMLAnchorElement | null = null;
        items.forEach((item) => {
            const href =
                (item.getAttribute("href") || "").replace(/\/$/, "") || "/";
            const isActive = href === currentPath;
            item.classList.toggle("active", isActive);
            if (isActive) activeItem = item;
        });

        // The collapsed width comes straight from the bar's own CSS
        // default (sized to comfortably fit "Menu") — read once, before
        // any inline style touches it, rather than trying to measure the
        // label's content directly (it's absolutely positioned over the
        // links, so its own scrollWidth would just report whatever the
        // bar currently is, not "Menu"'s true minimal size).
        const collapsedWidth = bar.getBoundingClientRect().width;
        gsap.set(navBg, { opacity: 0 });

        let isOpen = false;
        // Both open() and close() build a timeline touching the same
        // properties (bar width, items/logo/toggle opacity). A quick
        // enter/leave wobble — easy here since the wrapper's own bounding
        // box grows as the bar widens, shifting the hover boundary while
        // the pointer sits still — could previously fire both in quick
        // succession, leaving two timelines fighting over the same tweens
        // and `fromTo`'s immediateRender snapping things back mid-flight.
        // Killing the outgoing timeline before starting a new one collapses
        // that race into a single, always-smooth reversal.
        let activeTl: gsap.core.Timeline | null = null;

        function moveHighlightTo(item: HTMLElement, animate: boolean) {
            const x = item.offsetLeft;
            const width = item.offsetWidth;
            items.forEach((el) => el.classList.toggle("is-lit", el === item));
            if (animate && !reduced) {
                gsap.to(navBg, {
                    x,
                    width,
                    opacity: 1,
                    duration: 0.35,
                    ease: "power3.out",
                });
            } else {
                gsap.set(navBg, { x, width, opacity: 1 });
            }
        }

        function open() {
            if (isOpen) return;
            isOpen = true;
            wrapper!.dataset.state = "expanded";
            bar!.dataset.state = "expanded";
            trigger!.setAttribute("aria-expanded", "true");
            items.forEach((el) => el.setAttribute("tabindex", "0"));

            // `.pellmell-nav-item`s never shrink (flex-shrink: 0 in CSS),
            // so scrollWidth here reflects their true combined width even
            // while the bar itself is still visually clipped to the
            // collapsed size — same fix as the earlier "links pill
            // collapsed to nothing" bug, applied up front this time.
            const expandedWidth = bar!.scrollWidth;

            if (reduced) {
                gsap.set(bar, { width: expandedWidth });
                gsap.set(trigger, { opacity: 0 });
                gsap.set(items, { opacity: 1, y: 0 });
                gsap.set(logo, { opacity: 1, x: 0, scale: 1 });
                gsap.set(desktopToggle, { opacity: 1, x: 0, scale: 1 });
                if (activeItem) moveHighlightTo(activeItem, false);
                return;
            }

            activeTl?.kill();
            activeTl = gsap.timeline({
                onComplete: () => {
                    if (activeItem) moveHighlightTo(activeItem, true);
                },
            })
                .to(bar, {
                    width: expandedWidth,
                    duration: 0.45,
                    ease: "power3.inOut",
                })
                .to(trigger, { opacity: 0, duration: 0.15 }, 0)
                .to(
                    logo,
                    { opacity: 1, x: 0, scale: 1, duration: 0.4, ease: "back.out(1.6)" },
                    0.05,
                )
                .to(
                    desktopToggle,
                    { opacity: 1, x: 0, scale: 1, duration: 0.4, ease: "back.out(1.6)" },
                    0.05,
                )
                .to(
                    items,
                    {
                        opacity: 1,
                        y: 0,
                        duration: 0.25,
                        stagger: 0.018,
                        ease: "power3.out",
                    },
                    0.12,
                );
        }

        function close() {
            if (!isOpen) return;
            isOpen = false;
            trigger!.setAttribute("aria-expanded", "false");
            items.forEach((el) => {
                el.setAttribute("tabindex", "-1");
                el.classList.remove("is-lit");
            });

            if (reduced) {
                gsap.set(bar, { width: collapsedWidth });
                gsap.set(trigger, { opacity: 1 });
                gsap.set(items, { opacity: 0 });
                gsap.set(navBg, { opacity: 0 });
                gsap.set(logo, { opacity: 0, x: sideOffset, scale: 0.7 });
                gsap.set(desktopToggle, {
                    opacity: 0,
                    x: -sideOffset,
                    scale: 0.7,
                });
                bar!.dataset.state = "collapsed";
                wrapper!.dataset.state = "collapsed";
                return;
            }

            activeTl?.kill();
            // Fades and the bar's shrink all start together (rather than the
            // shrink waiting until the fades are nearly done) — previously
            // the bar sat at full width for ~0.2s after items had already
            // vanished, which read as a stall even though nothing was
            // actually frozen.
            activeTl = gsap.timeline({
                onComplete: () => {
                    bar!.dataset.state = "collapsed";
                    wrapper!.dataset.state = "collapsed";
                },
            })
                .to(navBg, { opacity: 0, duration: 0.15 }, 0)
                .to(items, { opacity: 0, duration: 0.15 }, 0)
                .to(
                    logo,
                    { opacity: 0, x: sideOffset, scale: 0.7, duration: 0.25, ease: "power2.in" },
                    0,
                )
                .to(
                    desktopToggle,
                    { opacity: 0, x: -sideOffset, scale: 0.7, duration: 0.25, ease: "power2.in" },
                    0,
                )
                .to(
                    bar,
                    {
                        width: collapsedWidth,
                        duration: 0.35,
                        ease: "power3.inOut",
                    },
                    0.05,
                )
                .to(trigger, { opacity: 1, duration: 0.25 }, 0.2);
        }

        trigger.addEventListener("click", () => (isOpen ? close() : open()), {
            signal,
        });

        // Hover is the primary way to open on desktop; click on the label
        // remains as a fallback for touch/keyboard.
        wrapper.addEventListener("mouseenter", open, { signal });
        wrapper.addEventListener("mouseleave", close, { signal });

        // The sliding highlight follows the cursor across items while
        // open, and rests back under the active page when the pointer
        // leaves the bar.
        items.forEach((item) => {
            item.addEventListener(
                "mouseenter",
                () => {
                    if (isOpen) moveHighlightTo(item, true);
                },
                { signal },
            );
        });

        bar.addEventListener(
            "mouseleave",
            () => {
                if (!isOpen) return;
                if (activeItem) {
                    moveHighlightTo(activeItem, true);
                } else {
                    items.forEach((el) => el.classList.remove("is-lit"));
                    gsap.to(navBg, { opacity: 0, duration: 0.2 });
                }
            },
            { signal },
        );

        document.addEventListener(
            "click",
            (e) => {
                if (isOpen && !wrapper!.contains(e.target as Node)) close();
            },
            { signal },
        );

        document.addEventListener(
            "keydown",
            (e: KeyboardEvent) => {
                if (e.key === "Escape" && isOpen) close();
            },
            { signal },
        );

        // Desktop-mode toggle — a real link (so it goes through Astro's
        // router and the GSAP curtain transition in Head.astro/
        // desktopTransition.ts like any other navigation), styled and
        // animated as a switch rather than a plain nav item. Reflects
        // current mode via aria-pressed, though in practice this header
        // never renders on /desktop itself.
        if (desktopToggle) {
            desktopToggle.setAttribute(
                "aria-pressed",
                String(window.location.pathname.replace(/\/$/, "") === "/desktop"),
            );
        }

        signal.addEventListener("abort", () => {
            bar!.dataset.state = "collapsed";
        });
    }

    /* ── Micro-interaction: Brand letter scatter on hover ── */
    function setupBrandScatter(signal: AbortSignal) {
        if (window.innerWidth < 1024) return;
        if (prefersReducedMotion()) return;
        const brand = document.getElementById("header-brand");
        if (!brand) return;

        brand.addEventListener(
            "mouseenter",
            () => {
                const letters = brand.querySelectorAll(".brand-letter");
                letters.forEach((letter) => {
                    const randomRotate = (Math.random() - 0.5) * 6;
                    const randomY = (Math.random() - 0.5) * 4;
                    gsap.to(letter, {
                        rotate: randomRotate,
                        y: randomY,
                        duration: 0.3,
                        ease: "power2.out",
                    });
                });
            },
            { signal },
        );

        brand.addEventListener(
            "mouseleave",
            () => {
                const letters = brand.querySelectorAll(".brand-letter");
                gsap.to(letters, {
                    rotate: 0,
                    y: 0,
                    duration: 0.4,
                    stagger: 0.02,
                    ease: "power2.out",
                });
            },
            { signal },
        );
    }

    /* ── Mobile Menu Logic ── */
    function setupMobileMenu(signal: AbortSignal) {
        const toggle = document.getElementById("mobile-menu-toggle");
        const overlay = document.getElementById("mobile-menu-overlay");
        const header = document.getElementById("site-header");
        const links = document.querySelectorAll(".mobile-nav-link");

        if (!toggle || !overlay || !header) return;

        let isOpen = false;
        const reduced = prefersReducedMotion();

        const toggleMenu = () => {
            isOpen = !isOpen;
            toggle.classList.toggle("active", isOpen);
            overlay.classList.toggle("active", isOpen);
            header.classList.toggle("menu-open", isOpen);
            document.body.style.overflow = isOpen ? "hidden" : "";

            if (isOpen && !reduced) {
                gsap.fromTo(
                    ".mobile-nav-link",
                    { opacity: 0, y: 20, x: -10 },
                    {
                        opacity: 1,
                        y: 0,
                        x: 0,
                        duration: 0.5,
                        stagger: 0.08,
                        ease: "power4.out",
                        delay: 0.2,
                    },
                );
            } else if (isOpen) {
                gsap.set(".mobile-nav-link", { opacity: 1, y: 0, x: 0 });
            }
        };

        toggle.addEventListener("click", toggleMenu, { signal });

        // Close on link click — and reset body overflow on dispose
        links.forEach((link) => {
            link.addEventListener(
                "click",
                () => {
                    if (isOpen) toggleMenu();
                },
                { signal },
            );
        });

        signal.addEventListener("abort", () => {
            // Make sure we don't leave the body locked if disposed mid-open
            document.body.style.overflow = "";
        });
    }

    document.addEventListener("astro:page-load", () => {
        registerAnimation("site-header", (_gsap, signal) => {
            const header = document.getElementById("site-header");
            if (!header) return;

            // Re-init: registerAnimation already disposed any prior listeners
            delete header.dataset.initialized;
            header.dataset.initialized = "true";
            // @ts-ignore
            window.headerReady = false;

            animateHeader();
            setupPellmellNav(signal);
            setupBrandScatter(signal);
            setupMobileMenu(signal);
        });
    });

    /* ── Keyboard shortcuts ── */

    function showToast(label: string, hint: string) {
        const toast = document.getElementById("shortcut-toast");
        if (!toast) return;

        toast.textContent = `→ ${label}`;
        toast.setAttribute("data-key", hint);
        toast.classList.add("visible");

        setTimeout(() => toast.classList.remove("visible"), 1200);
    }

    function toggleHelpPanel() {
        const panel = document.getElementById("shortcut-panel");
        const header = document.querySelector("header");
        if (!panel) return;
        const isOpen = panel.classList.toggle("open");
        panel.setAttribute("aria-hidden", String(!isOpen));

        if (header) {
            header.classList.toggle("shortcuts-revealed", isOpen);
        }
    }

    // ── Tinykeys binding (per-session, not per-page) ──
    // Bind once at module load. Tinykeys returns an unbind function we keep
    // around so a hot reload (HMR) or a future "destroy" hook can remove it.
    let unbindShortcuts: (() => void) | null = null;

    function buildShortcutPanel() {
        const list = document.getElementById("shortcut-list");
        if (!list || list.dataset.populated) return;
        list.dataset.populated = "true";
        NAV_SHORTCUTS.forEach((s) => {
            const li = document.createElement("li");
            const kbdHtml = s.displayKeys
                .map((k) => `<kbd>${k}</kbd>`)
                .join(" ");
            li.innerHTML = `<span class="shortcut-label">${s.label}</span><div class="shortcut-keys">${kbdHtml}</div>`;
            list.appendChild(li);
        });
    }

    function bindShortcuts() {
        if (unbindShortcuts) return;

        const bindings: Record<string, (e: KeyboardEvent) => void> = {};

        NAV_SHORTCUTS.forEach((shortcut) => {
            bindings[shortcut.keys] = (e: KeyboardEvent) => {
                e.preventDefault();
                showToast(shortcut.label, shortcut.hint);
                setTimeout(() => {
                    window.location.href = shortcut.href;
                }, 300);
            };
        });

        bindings["Shift+?"] = (e: KeyboardEvent) => {
            e.preventDefault();
            toggleHelpPanel();
        };

        unbindShortcuts = tinykeys(window, bindings);
    }

    // Build the panel + bindings on initial load. The Header's DOM survives
    // view transitions, so these only need to run once per hard load.
    buildShortcutPanel();
    bindShortcuts();

    // Re-build the shortcut panel after each page swap in case the DOM was
    // replaced (idempotent thanks to dataset.populated).
    document.addEventListener("astro:page-load", buildShortcutPanel);
</script>

<style lang="scss">
    @use "../../styles/variables" as *;

    header#site-header {
        background: transparent;
        color: $color-white;
        opacity: 1;
        transition: opacity 0.4s ease;
        padding: 3rem 0;

        &.header-anim {
            opacity: 0;
            pointer-events: none;
        }
    }

    :global(.header-skip-anim) header#site-header {
        &.header-anim {
            opacity: 1;
            pointer-events: auto;
        }

        .brand,
        .desktop-nav,
        .actions-group {
            opacity: 1 !important;
        }
    }

    header .header-content {
        position: relative;
        display: flex;
        flex-wrap: nowrap;
        // Only .pellmell-wrapper renders here now (nav-group/actions-group
        // are commented out of the markup) — center it via the parent flex
        // container itself rather than the wrapper self-centering with
        // `left: 50%; transform: translate(-50%)`, which anchors against
        // its own box and drifts as that box's width changes.
        justify-content: center;
        align-items: center;
        width: 100%;
        background: transparent;
    }

    .nav-group {
        display: flex;
        align-items: center;
