---
import { getCollection } from "astro:content";
import Container from "@components/atoms/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import Link from "@components/atoms/Link.astro";
import Button from "@components/atoms/Button.astro";
import ProjectCard from "@components/molecules/ProjectCard.astro";
import PostCard from "@components/molecules/PostCard.astro";
import { SITE, HOME, SOCIALS } from "@consts";
import Expertise from "@components/organisms/Expertise.astro";
import About from "@components/organisms/About.astro";
import AmbientBackgroundFX from "@components/molecules/AmbientBackgroundFX.astro";

const blog = (await getCollection("blog"))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const projects = (await getCollection("projects"))
    .filter((project) => !project.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
    <AmbientBackgroundFX />
    <Container>
        <div class="title-container" data-scroll-personality="cinematic">
            <div class="hero-status" id="hero-status">
                <span class="status-dot"></span>
                Open to work — Brand Lead, crafting digital experiences.
            </div>
            <h1 class="display-title" id="hero-title">
                Transform Your Ideas<br />
                Into Interactive<br />
                Masterpieces.
            </h1>
            <canvas
                id="hero-title-canvas"
                class="hero-title-canvas"
                aria-hidden="true"></canvas>
        </div>
        <div class="content-wrapper">
            <section
                class="animate section"
                data-scroll-personality="technical"
            >
                <div class="section-header">
                    <h5 class="section-title">Recent projects</h5>
                    <Link href="/work"> See all projects </Link>
                </div>
                <ul class="project-grid">
                    {
                        projects.map((project, index) => (
                            <li>
                                <ProjectCard
                                    project={project}
                                    loading={index === 0 ? "eager" : "lazy"}
                                    fetchpriority={
                                        index === 0 ? "high" : "auto"
                                    }
                                />
                            </li>
                        ))
                    }
                </ul>
                <div class="view-all-wrapper">
                    <Button href="/work" variant="outline">
                        View All Projects
                    </Button>
                </div>
            </section>
            <About />
            <Expertise />

            <section class="animate section" data-scroll-personality="default">
                <div class="section-header">
                    <h5 class="section-title">Latest posts</h5>
                    <Link href="/blog"> See all posts </Link>
                </div>
                <ul class="post-grid">
                    {
                        blog.map((post, index) => (
                            <li>
                                <PostCard
                                    post={post}
                                    loading={index === 0 ? "eager" : "lazy"}
                                    fetchpriority={
                                        index === 0 ? "high" : "auto"
                                    }
                                />
                            </li>
                        ))
                    }
                </ul>
            </section>
        </div>
    </Container>
</PageLayout>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import { registerAnimation, prefersReducedMotion } from "@lib/animation";
    import { PixelTextFX } from "@lib/pixelTextFX";

    gsap.registerPlugin(ScrollTrigger);

    const HERO_LINES = [
        "Transform Your Ideas",
        "Into Interactive",
        "Masterpieces.",
    ];

    document.addEventListener("astro:page-load", () => {
        registerAnimation("home:hero", (gsap, signal) => {
            const statusCard = document.getElementById("hero-status");
            const heroTitle = document.getElementById("hero-title");
            const titleCanvas = document.getElementById(
                "hero-title-canvas",
            ) as HTMLCanvasElement | null;
            const reduced = prefersReducedMotion();

            // The WebGL hover-follow layer only takes over once the DOM
            // letter reveal has actually finished — trying to run both at
            // once would fight over the same <h1>.
            const startTitleHoverFX = () => {
                if (!heroTitle || !titleCanvas) return;
                const gl = (titleCanvas.getContext("webgl") ||
                    titleCanvas.getContext(
                        "experimental-webgl",
                    )) as WebGLRenderingContext | null;
                if (!gl) return;
                try {
                    // eslint-disable-next-line no-new -- disposal wired via AbortSignal
                    new PixelTextFX(
                        heroTitle,
                        HERO_LINES,
                        titleCanvas,
                        gl,
                        signal,
                    );
                } catch {
                    // Shader/program setup failed — leave the plain <h1> visible.
                }
            };

            if (heroTitle) {
                heroTitle.innerHTML = "";
                const allSpans: HTMLElement[] = [];

                HERO_LINES.forEach((line) => {
                    const lineDiv = document.createElement("div");
                    lineDiv.style.display = "flex";
                    lineDiv.style.flexWrap = "wrap";

                    const words = line.split(" ");
                    words.forEach((word, wordIndex) => {
                        const wordDiv = document.createElement("div");
                        wordDiv.style.display = "flex";

                        word.split("").forEach((char) => {
                            // Outer wrapper clips the letter so it looks
                            // like it slides up out of a mask, rather than
                            // fading in mid-air.
                            const wrapper = document.createElement("span");
                            wrapper.style.display = "inline-block";
                            wrapper.style.overflow = "hidden";
                            wrapper.style.lineHeight = "0.9";
                            wrapper.style.padding = "0.05em 0";

                            const span = document.createElement("span");
                            span.textContent = char;
                            span.style.display = "inline-block";
                            span.style.willChange = "transform, opacity";

                            wrapper.appendChild(span);
                            wordDiv.appendChild(wrapper);
                            allSpans.push(span);
                        });

                        lineDiv.appendChild(wordDiv);

                        if (wordIndex < words.length - 1) {
                            const spaceSpan = document.createElement("span");
                            spaceSpan.innerHTML = "&nbsp;";
                            lineDiv.appendChild(spaceSpan);
                        }
                    });

                    heroTitle.appendChild(lineDiv);
                });

                gsap.set(heroTitle, { opacity: 1 });

                if (reduced) {
                    gsap.set(allSpans, { opacity: 1, y: "0%" });
                    startTitleHoverFX();
                } else {
                    gsap.fromTo(
                        allSpans,
                        { opacity: 0, y: "110%" },
                        {
                            opacity: 1,
                            y: "0%",
                            duration: 0.9,
                            stagger: 0.02,
                            ease: "power3.out",
                            onComplete: startTitleHoverFX,
                        },
                    );
                }
            }

            if (reduced) {
                if (statusCard)
                    gsap.set(statusCard, {
                        opacity: 1,
                        y: 0,
                        filter: "blur(0px)",
                    });
            } else if (statusCard) {
                gsap.fromTo(
                    statusCard,
                    { opacity: 0, y: 10, filter: "blur(4px)" },
                    {
                        opacity: 1,
                        y: 0,
                        filter: "blur(0px)",
                        duration: 0.6,
                        ease: "power2.out",
                    },
                );
            }

            /* ── Scroll Reveals for Sections ── */
            const animateEls = document.querySelectorAll(".animate");
            if (reduced) {
                gsap.set(animateEls, { opacity: 1, y: 0 });
            } else {
                animateEls.forEach((el) => {
                    gsap.fromTo(
                        el,
                        { opacity: 0, y: 30 },
                        {
                            opacity: 1,
                            y: 0,
                            duration: 0.8,
                            ease: "power2.out",
                            scrollTrigger: {
                                trigger: el,
                                start: "top 85%",
                                toggleActions: "play none none none",
                            },
                        },
                    );
                });
            }
        });
    });
</script>

<style lang="scss">
    @use "../styles/variables" as *;
    @use "../styles/mixins" as *;

    /* ── Hero Animation Targets ── */

    #hero-status,
    #hero-title {
        opacity: 0; // Initially hidden, Motion will animate in
    }

    .title-container {
        position: relative;
        width: 100%;
        margin: 0;
        // margin-top: 2rem; // Increased for extra mobile spacing
        // margin-bottom: 2rem;
        z-index: 10;

        // @include screen(md) {
        //     margin-top: 5rem;
        //     margin-bottom: 5rem;
        // }
    }

    .hero-status {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        margin-bottom: 1.25rem;
        font-family: $font-sans;
        font-size: 0.85rem;
        font-weight: 500;
        letter-spacing: -0.01em;
        color: rgba($color-black, 0.55);

        @include screen(md) {
            margin-bottom: 1.5rem;
            font-size: 0.95rem;
        }

        :global(.dark) & {
            color: rgba($color-white, 0.55);
        }

        .status-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #10b981;
            flex-shrink: 0;
        }
    }

    .display-title {
        font-size: clamp(2.6rem, 13vw, 4.5rem);
        line-height: 1.02;
        font-weight: 600;
        letter-spacing: -0.04em;
        color: $color-black;
        margin: 0;

        :global(.dark) & {
            color: $color-white;
        }

        @include screen(md) {
            font-size: clamp(5rem, 10vw, 10rem);
        }
    }

    .hero-title-canvas {
        position: absolute;
        z-index: 1;
        opacity: 0;
        pointer-events: auto;
    }

    /* ── Layout ── */

    .content-wrapper {
        display: flex;
        flex-direction: column;
        gap: 4rem;
    }

    .bio {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .section {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .section-header {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        align-items: center;
        justify-content: space-between;
    }

    .section-title {
        font-weight: 600;
        letter-spacing: -0.02em;
        text-transform: none;
        color: $color-black;

        :global(.dark) & {
            color: $color-white;
        }
    }

    .project-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 3rem;
        list-style: none;
        padding: 0;
        margin-top: 2rem;

        @include screen(lg) {
            grid-template-columns: repeat(2, 1fr);
            gap: 2.5rem;
        }
    }

    .view-all-wrapper {
        display: flex;
        justify-content: center;
        margin-top: 3rem;
    }

    .post-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
        list-style: none;
        padding: 0;
        margin-top: 2rem;

        @include screen(sm) {
            grid-template-columns: repeat(2, 1fr);
        }

        @include screen(lg) {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    .socials {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .social-item {
        display: flex;
        gap: 0.5rem;
        white-space: nowrap;
    }
</style>
