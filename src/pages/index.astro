---
import { getCollection } from "astro:content";
import Container from "@components/atoms/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import Link from "@components/atoms/Link.astro";
import Button from "@components/atoms/Button.astro";
import ProjectCard from "@components/molecules/ProjectCard.astro";
import PostCard from "@components/molecules/PostCard.astro";
import { SITE, HOME, SOCIALS } from "@consts";
import About from "@components/organisms/About.astro";
import ProcessTeaser from "@components/organisms/ProcessTeaser.astro";
import AmbientBackgroundFX from "@components/molecules/AmbientBackgroundFX.astro";

const blog = (await getCollection("blog"))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const projects = (await getCollection("projects"))
    .filter((project) => !project.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
    <!-- <AmbientBackgroundFX /> -->
    <Container>
        <div class="title-container" data-scroll-personality="cinematic">
            <div class="hero-status" id="hero-status">
                <span class="status-dot"></span>
                Open to work — Cross-Functional Developer, crafting digital experiences.
            </div>
            <!-- Real heading kept for SEO/screen readers — the canvas
                 below is the only visible rendering of it, so a page with
                 no visible <h1> at all would otherwise lose its heading
                 entirely. If WebGL/the canvas fails, script below reveals
                 this as the visible fallback instead of leaving the hero
                 blank. -->
            <h1 class="sr-only" id="hero-title-fallback">
                Transform Your Ideas Into Interactive Masterpieces.
            </h1>
            <!-- Invisible (but real, laid-out) source element for
                 PixelTextFX to read font metrics/position from — it needs
                 its own element separate from the canvas it overlays, not
                 the canvas measuring itself (that broke hover: the
                 velocity math ended up reading a degenerate rect). -->
            <div
                id="hero-title-metrics"
                class="hero-title-metrics"
                aria-hidden="true"
            >
                Transform Your Ideas<br />
                Into Interactive<br />
                Masterpieces.
            </div>
            <canvas
                id="hero-title-canvas"
                class="hero-title-canvas"
                aria-hidden="true"></canvas>
        </div>
        <div class="content-wrapper">
            <section
                class="animate section"
                data-scroll-personality="technical"
            >
                <div class="section-header">
                    <h5 class="section-title">Recent projects</h5>
                    <Link href="/work"> See all projects </Link>
                </div>
                <ul class="project-grid">
                    {
                        projects.map((project, index) => (
                            <li>
                                <ProjectCard
                                    project={project}
                                    loading={index === 0 ? "eager" : "lazy"}
                                    fetchpriority={
                                        index === 0 ? "high" : "auto"
                                    }
                                />
                            </li>
                        ))
                    }
                </ul>
                <div class="view-all-wrapper">
                    <Button href="/work" variant="outline">
                        View All Projects
                    </Button>
                </div>
            </section>

            <ProcessTeaser />

            <About />

            <section class="animate section" data-scroll-personality="default">
                <div class="section-header">
                    <h5 class="section-title">Latest posts</h5>
                    <Link href="/blog"> See all posts </Link>
                </div>
                <ul class="post-grid">
                    {
                        blog.map((post, index) => (
                            <li>
                                <PostCard
                                    post={post}
                                    loading={index === 0 ? "eager" : "lazy"}
                                    fetchpriority={
                                        index === 0 ? "high" : "auto"
                                    }
                                />
                            </li>
                        ))
                    }
                </ul>
            </section>
        </div>
    </Container>
</PageLayout>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import { registerAnimation, prefersReducedMotion } from "@lib/animation";
    import { PixelTextFX } from "@lib/pixelTextFX";

    gsap.registerPlugin(ScrollTrigger);

    const HERO_LINES = [
        "Transform Your Ideas",
        "Into Interactive",
        "Masterpieces.",
    ];

    document.addEventListener("astro:page-load", () => {
        registerAnimation("home:hero", (gsap, signal) => {
            const statusCard = document.getElementById("hero-status");
            const titleMetrics = document.getElementById(
                "hero-title-metrics",
            );
            const titleCanvas = document.getElementById(
                "hero-title-canvas",
            ) as HTMLCanvasElement | null;
            const reduced = prefersReducedMotion();

            // Reveals the sr-only <h1> as real, visible fallback text —
            // only reached if WebGL/the canvas isn't available, since
            // otherwise the hero would render nothing at all.
            const revealFallbackHeading = () => {
                document
                    .getElementById("hero-title-fallback")
                    ?.classList.add("hero-fallback-visible");
                if (titleCanvas) titleCanvas.style.display = "none";
                if (titleMetrics) titleMetrics.style.display = "none";
            };

            const startTitleHoverFX = () => {
                if (!titleMetrics || !titleCanvas) return;
                const gl = (titleCanvas.getContext("webgl") ||
                    titleCanvas.getContext(
                        "experimental-webgl",
                    )) as WebGLRenderingContext | null;
                if (!gl) {
                    revealFallbackHeading();
                    return;
                }
                try {
                    // eslint-disable-next-line no-new -- disposal wired via AbortSignal
                    new PixelTextFX(
                        titleMetrics,
                        HERO_LINES,
                        titleCanvas,
                        gl,
                        signal,
                    );
                } catch {
                    revealFallbackHeading();
                }
            };

            startTitleHoverFX();

            if (reduced) {
                if (statusCard)
                    gsap.set(statusCard, {
                        opacity: 1,
                        y: 0,
                        filter: "blur(0px)",
                    });
            } else if (statusCard) {
                gsap.fromTo(
                    statusCard,
                    { opacity: 0, y: 10, filter: "blur(4px)" },
                    {
                        opacity: 1,
                        y: 0,
                        filter: "blur(0px)",
                        duration: 0.6,
                        ease: "power2.out",
                    },
                );
            }

            /* ── Scroll Reveals for Sections ── */
            const animateEls = document.querySelectorAll(".animate");
            if (reduced) {
                gsap.set(animateEls, { opacity: 1, y: 0 });
            } else {
                animateEls.forEach((el) => {
                    gsap.fromTo(
                        el,
                        { opacity: 0, y: 30 },
                        {
                            opacity: 1,
                            y: 0,
                            duration: 0.8,
                            ease: "power2.out",
                            scrollTrigger: {
                                trigger: el,
                                start: "top 85%",
                                toggleActions: "play none none none",
                            },
                        },
                    );
                });
            }
        });
    });
</script>

<style lang="scss">
    @use "../styles/variables" as *;
    @use "../styles/mixins" as *;

    /* ── Hero Animation Targets ── */

    #hero-status {
        opacity: 0; // Initially hidden, GSAP animates it in
    }

    // #hero-title stays at its default opacity/color — PixelTextFX hides
    // it (color: transparent) once the canvas is ready; if WebGL is
    // unavailable, this is the visible fallback heading, so it must never
    // start hidden.

    .title-container {
        position: relative;
        width: 100%;
        margin: 0;
        // margin-top: 2rem; // Increased for extra mobile spacing
        // margin-bottom: 2rem;
        z-index: 10;

        // @include screen(md) {
        //     margin-top: 5rem;
        //     margin-bottom: 5rem;
        // }
    }

    .hero-status {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        margin-bottom: 1.25rem;
        font-family: $font-sans;
        font-size: 0.85rem;
        font-weight: 500;
        letter-spacing: -0.01em;
        color: rgba($color-black, 0.55);

        @include screen(md) {
            margin-bottom: 1.5rem;
            font-size: 0.95rem;
        }

        :global(.dark) & {
            color: rgba($color-white, 0.55);
        }

        .status-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #10b981;
            flex-shrink: 0;
        }
    }

    // Same typography the removed <h1>.display-title used — invisible
    // (visibility: hidden, not display: none or the .sr-only clip trick —
    // both of those collapse or zero out the element's rect, which is
    // exactly what PixelTextFX needs to read a real size from) but still
    // fully laid out, so it gives the hero the same height the old visible
    // heading did and gives PixelTextFX real font metrics to measure text
    // wrapping against.
    .hero-title-metrics {
        visibility: hidden;
        font-family: $font-display;
        font-size: clamp(2.6rem, 13vw, 4.5rem);
        line-height: 1.02;
        font-weight: 600;
        letter-spacing: -0.04em;
        margin: 0;

        @include screen(md) {
            font-size: clamp(5rem, 10vw, 10rem);
        }
    }

    .hero-title-canvas {
        position: absolute;
        z-index: 1;
        opacity: 0;
        pointer-events: auto;
    }

    // Overrides .sr-only's clipping — only applied by script when WebGL/
    // the canvas isn't available, so the hero still shows real text
    // instead of rendering nothing.
    #hero-title-fallback.hero-fallback-visible {
        position: static;
        width: auto;
        height: auto;
        margin: 0;
        padding: 0;
        overflow: visible;
        clip: auto;
        white-space: normal;
        font-family: $font-display;
        font-size: clamp(2.6rem, 13vw, 4.5rem);
        line-height: 1.02;
        font-weight: 600;
        letter-spacing: -0.04em;
        color: $color-black;

        :global(.dark) & {
            color: $color-white;
        }

        @include screen(md) {
            font-size: clamp(5rem, 10vw, 10rem);
        }
    }

    /* ── Layout ── */

    .content-wrapper {
        display: flex;
        flex-direction: column;
        gap: 4rem;
    }

    .bio {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .section {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .section-header {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        align-items: center;
        justify-content: space-between;
    }

    .section-title {
        font-weight: 600;
        letter-spacing: -0.02em;
        text-transform: none;
        color: $color-black;

        :global(.dark) & {
            color: $color-white;
        }
    }

    .project-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 3rem;
        list-style: none;
        padding: 0;
        margin-top: 2rem;

        @include screen(lg) {
            grid-template-columns: repeat(2, 1fr);
            gap: 2.5rem;
        }
    }

    .view-all-wrapper {
        display: flex;
        justify-content: center;
        margin-top: 3rem;
    }

    .post-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
        list-style: none;
        padding: 0;
        margin-top: 2rem;

        @include screen(sm) {
            grid-template-columns: repeat(2, 1fr);
        }

        @include screen(lg) {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    .socials {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .social-item {
        display: flex;
        gap: 0.5rem;
        white-space: nowrap;
    }
</style>
